# ===================================
# App Mundial — Variables de Entorno
# ===================================
# Copia este archivo a .env y completa los valores

# Base de datos PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/appmundial?schema=public"

# Football-Data.org API (free tier: 10 req/min)
# Registrarse en: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY="tu-api-key-aqui"

# The Odds API (free tier: 500 créditos/mes)
# Registrarse en: https://the-odds-api.com/#get-access
ODDS_API_KEY="tu-api-key-aqui"

# Server
PORT=3001
NODE_ENV=development
