// =====================================================
// Prisma Schema — App Mundial de Predicciones
// =====================================================
// Modelo ER basado en: Tournament → Groups → Teams/Matches
//                       User → Predictions → PredictionItems

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")       // Pooler (transacciones)
  directUrl = env("DIRECT_URL")         // Directo (migraciones)
}

// ── Torneo ──────────────────────────────────────────────

model Tournament {
  id           String   @id @default(cuid())
  name         String               // "FIFA World Cup 2026"
  code         String   @unique     // "WC"
  year         Int
  currentStage String   @default("GROUP_STAGE")
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  groups      Group[]
  predictions UserPrediction[]

  @@map("tournaments")
}

// ── Equipo ──────────────────────────────────────────────

model Team {
  id            String   @id @default(cuid())
  name          String               // "Argentina"
  shortName     String?              // "ARG"
  tla           String?              // Three-Letter Abbreviation: "ARG", "BRA"
  crestUrl      String?              // URL del escudo (scrapeado de Wikipedia)
  flagUrl       String?              // URL de la bandera
  fifaRanking   Int?                 // Ranking FIFA al momento del torneo
  confederation String?              // CONMEBOL, UEFA, CAF, etc.
  coach         String?              // Nombre del entrenador
  wikipediaUrl  String?              // URL de Wikipedia del equipo
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  groupTeams         GroupTeam[]
  homeMatches        Match[]          @relation("HomeTeam")
  awayMatches        Match[]          @relation("AwayTeam")
  groupOdds          GroupOdd[]
  firstPlacePicks    PredictionItem[] @relation("FirstPlace")
  secondPlacePicks   PredictionItem[] @relation("SecondPlace")
  players            Player[]

  @@unique([name])
  @@map("teams")
}

// ── Grupo ───────────────────────────────────────────────

model Group {
  id           String   @id @default(cuid())
  name         String                // "Group A", "Group B", etc.
  tournamentId String
  stage        String   @default("GROUP_STAGE")

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groupTeams   GroupTeam[]
  matches      Match[]
  groupOdds    GroupOdd[]
  predictionItems PredictionItem[]

  @@unique([tournamentId, name])
  @@map("groups")
}

// ── Equipo en Grupo (tabla de posiciones) ───────────────

model GroupTeam {
  id            String @id @default(cuid())
  groupId       String
  teamId        String
  position      Int    @default(0)     // Posición actual en el grupo
  playedGames   Int    @default(0)
  won           Int    @default(0)
  draw          Int    @default(0)
  lost          Int    @default(0)
  goalsFor      Int    @default(0)
  goalsAgainst  Int    @default(0)
  goalDifference Int   @default(0)
  points        Int    @default(0)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([groupId, teamId])
  @@map("group_teams")
}

// ── Partido ─────────────────────────────────────────────

model Match {
  id          String    @id @default(cuid())
  groupId     String?
  stage       String    @default("GROUP_STAGE") // GROUP_STAGE, ROUND_OF_32, etc.
  homeTeamId  String
  awayTeamId  String
  matchday    Int?                              // Jornada dentro del grupo (1, 2 o 3)
  matchDate   DateTime                          // Fecha y hora del partido (UTC)
  venue       String?                           // Estadio
  city        String?                           // Ciudad sede
  status      String    @default("SCHEDULED")  // SCHEDULED, IN_PLAY, FINISHED
  homeScore   Int?
  awayScore   Int?
  homePenalty Int?                              // Penales (eliminatorias)
  awayPenalty Int?                              // Penales (eliminatorias)
  scrapedAt   DateTime?                         // Cuándo fue scrapeado por última vez

  group       Group?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  homeTeam    Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam    Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  odds        MatchOdd[]
  playerStats PlayerStat[]

  @@map("matches")
}

// ── Cuotas de Partido ───────────────────────────────────
// Reservado para Fase 2 si se incorporan probabilidades basadas en odds

model MatchOdd {
  id        String   @id @default(cuid())
  matchId   String
  bookmaker String
  homeWin   Float
  draw      Float
  awayWin   Float
  updatedAt DateTime @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, bookmaker])
  @@map("match_odds")
}

// ── Cuotas Outright de Grupo ────────────────────────────

model GroupOdd {
  id         String   @id @default(cuid())
  groupId    String
  teamId     String
  bookmaker  String
  toQualify  Float?
  toWinGroup Float?
  updatedAt  DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([groupId, teamId, bookmaker])
  @@map("group_odds")
}

// ── Jugador ─────────────────────────────────────────────

model Player {
  id           String  @id @default(cuid())
  teamId       String
  name         String
  position     String?              // GK, DEF, MID, FWD
  number       Int?                 // Número de camiseta
  dateOfBirth  DateTime?
  nationality  String?
  club         String?              // Club actual
  photoUrl     String?
  wikipediaUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  team  Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  stats PlayerStat[]

  @@unique([teamId, number])
  @@map("players")
}

// ── Estadísticas de Jugador por Partido ─────────────────

model PlayerStat {
  id           String  @id @default(cuid())
  playerId     String
  matchId      String
  goals        Int     @default(0)
  assists      Int     @default(0)
  yellowCards  Int     @default(0)
  redCards     Int     @default(0)
  minutesPlayed Int    @default(0)
  rating       Float?               // Rating de Sofascore (0-10)
  source       String  @default("sofascore") // De dónde se scrapeó
  scrapedAt    DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([playerId, matchId])
  @@map("player_stats")
}

// ── Log de Scraping ─────────────────────────────────────
// Registro de cada ejecución del scraper (admin)

model ScrapingLog {
  id          String   @id @default(cuid())
  triggeredAt DateTime @default(now())
  stage       String                    // GROUP_STAGE, ROUND_OF_16, etc.
  matchday    Int?                      // Jornada (solo fase de grupos)
  status      String   @default("RUNNING") // RUNNING, SUCCESS, PARTIAL, FAILED
  source      String   @default("SCHEDULED") // SCHEDULED o MANUAL
  durationMs  Int?                      // Tiempo total de ejecución
  matchesUpdated Int   @default(0)      // Cuántos partidos se actualizaron
  playersUpdated Int   @default(0)      // Cuántos registros de jugadores
  errors      Json?                     // Errores por scraper {espn: null, sofascore: "..."}  
  details     Json?                     // Info adicional de la ejecución

  @@map("scraping_logs")
}

// ── Usuario ─────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String
  createdAt   DateTime @default(now())

  predictions UserPrediction[]

  @@map("users")
}

// ── Predicción del Usuario ──────────────────────────────
// Una predicción completa por torneo

model UserPrediction {
  id                  String   @id @default(cuid())
  userId              String
  tournamentId        String
  combinedProbability Float?           // Probabilidad combinada calculada
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  items      PredictionItem[]

  @@unique([userId, tournamentId])
  @@map("user_predictions")
}

// ── Item de Predicción ──────────────────────────────────
// El usuario elige 1ro y 2do de cada grupo

model PredictionItem {
  id                String @id @default(cuid())
  predictionId      String
  groupId           String
  firstPlaceTeamId  String
  secondPlaceTeamId String
  groupProbability  Float?        // Probabilidad individual de esta predicción de grupo

  prediction  UserPrediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  group       Group          @relation(fields: [groupId], references: [id])
  firstPlace  Team           @relation("FirstPlace", fields: [firstPlaceTeamId], references: [id])
  secondPlace Team           @relation("SecondPlace", fields: [secondPlaceTeamId], references: [id])

  @@unique([predictionId, groupId])
  @@map("prediction_items")
}
